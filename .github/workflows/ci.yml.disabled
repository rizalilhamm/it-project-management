name: CI - Feature Projects Operation

# 1. Trigger on the specific feature branch
on:
  push:
    branches:
      - feature/projects-operation
  pull_request:
    branches:
      - feature/projects-operation
      
# Defines a single job for building and testing the application
jobs:
  build_and_test:
    runs-on: ubuntu-latest
    
    # Use a matrix strategy to test on a specific Node.js version
    strategy:
      matrix:
        node-version: [20.x] # Adjust this to your required Node.js version

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Setup Node.js ${{ matrix.node-version }}
        uses: actions/setup-node@v4
        with:
          node-version: ${{ matrix.node-version }}
          cache: 'npm'
          
      # --- Install Dependencies (Client and Server) ---

      - name: Install Server Dependencies
        run: npm install
        working-directory: ./server # Assuming server code is in a 'server' folder

      - name: Install Client Dependencies
        run: npm install
        working-directory: ./client # Assuming client code is in a 'client' folder
        
      # --- Code Quality and Testing (Server) ---

      - name: Server Linting (Code Quality Check)
        # Assuming you have a 'lint' script in your server/package.json
        run: npm run lint
        working-directory: ./server

      - name: Run Server Tests
        # Assuming you have a 'test' script in your server/package.json
        run: npm run test
        working-directory: ./server
        
      # --- Code Quality and Testing (Client) ---

      - name: Client Linting (Code Quality Check)
        # Assuming you have a 'lint' script in your client/package.json
        run: npm run lint
        working-directory: ./client
        
      - name: Run Client Tests
        # Assuming you have a 'test' script in your client/package.json
        run: npm run test
        working-directory: ./client

      # --- Optional Build Step (for Frontend) ---
      
      - name: Build Client (Frontend) Application
        # This checks that the frontend can build successfully
        run: npm run build
        working-directory: ./client
        
# Note: For full-stack integration tests requiring a database, you would 
# need to add a service container (e.g., MongoDB, PostgreSQL) to this job.